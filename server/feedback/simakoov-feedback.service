[Unit]
Description=simakoov.ru feedback form backend
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/simakoov-feedback.env
ExecStart=/usr/bin/python3 /opt/simakoov-feedback/feedback.py
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
