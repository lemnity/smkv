# Copy to /etc/simakoov-feedback.env on the server (chmod 600) and fill in.
# At least one channel (email or Telegram) must be configured.

# --- Email (Gmail) ---
# SMTP_PASSWORD is a Gmail *app password* (16 letters), not the account password:
# Google Account → Security → 2-Step Verification (on) → App passwords → create "simakoov site".
MAIL_TO=thesimakov@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=thesimakov@gmail.com
SMTP_PASSWORD=

# --- Telegram (optional duplicate) ---
# Bot token from @BotFather; chat id: write the bot any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TG_BOT_TOKEN=
TG_CHAT_ID=
