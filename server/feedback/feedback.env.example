# Copy to /etc/simakoov-feedback.env on the server (chmod 600) and fill in.

# --- Email ---
# By default letters go through the server's own send-only Postfix (127.0.0.1:25, no password),
# signed with DKIM for simakoov.ru (key: /etc/opendkim/keys/simakoov.ru/mail.txt).
# DNS for simakoov.ru must have SPF + DKIM (+ DMARC) records, otherwise Gmail may drop the letters.
MAIL_TO=thesimakov@gmail.com
MAIL_FROM=noreply@simakoov.ru
SMTP_HOST=127.0.0.1
SMTP_PORT=25

# To relay through an external provider instead (e.g. Gmail, port 587 — 465 is blocked on the VPS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=thesimakov@gmail.com
# SMTP_PASSWORD=<app password>

# --- Telegram (optional duplicate) ---
# NOTE: api.telegram.org is not reachable from the simakoov.ru VPS, so leave these empty there.
# Bot token from @BotFather; chat id: write the bot any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TG_BOT_TOKEN=
TG_CHAT_ID=
